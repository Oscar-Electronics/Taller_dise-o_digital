);
        //metodo para presionar teclas (este funciona mal)
        private void PressKey(ushort key, ref bool state)
        {
            if (!state)
            {
                INPUT input = new INPUT();
                input.type = 1;
                input.U.ki.wVk = key;
                SendInput(
                    1,
                    new INPUT[] { input },
                    Marshal.SizeOf(typeof(INPUT))
                );
                state = true;
            }
        }
        //metodo para soltar teclas (este funciona mal)
        private void ReleaseKey(ushort key, ref bool state)
        {
            if (state)
            {
                INPUT input = new INPUT();
                input.type = 1;
                input.U.ki.wVk = key;
                input.U.ki.dwFlags = KEYEVENTF_KEYUP;
                SendInput(
                    1,
                    new INPUT[] { input },
                    Marshal.SizeOf(typeof(INPUT))
                );
                state = false;
            }
        }
        //metodo para presionar teclas (este funciona bien para los juegos)
