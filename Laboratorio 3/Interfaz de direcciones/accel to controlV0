        //cuando se esta recibiendo datos hace lo siguiente
        private void SerialPort_DataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            try
            {
                //leer datos para acomodarlos en el text box de monitos serial y usarlos en los calculos
                string data = serialPort.ReadLine();
                Invoke(new Action(() =>
                {
                    textBoxData.AppendText(
            "[" + data + "]" +
            Environment.NewLine
        );
                    string[] parts = data.Trim().Split(' ');
                    if (parts.Length != 3)
                        return;
                    double x;
                    double y;
                    double z;
                    if (!double.TryParse(parts[0].Split('=')[1], out x))
                        return;

                    if (!double.TryParse(parts[1].Split('=')[1], out y))
                        return;

                    if (!double.TryParse(parts[2].Split('=')[1], out z))
                        return;
                    accelX = x;
                    accelY = y;
                    accelZ = z;
                    /*
                     * esta seccion es para cuando la UART envia en formato XX==####
                    string[] parts = data.Trim().Split(
                        new char[] { ' ' },
                        StringSplitOptions.RemoveEmptyEntries
                    );
                    if (parts.Length < 3)
                        return;
                    // Extraer X
                    string xStr = parts[0].Replace("XX==", "");
                    xStr = FixXValue(xStr);
                    // Extraer Y
                    string yStr = parts[1].Replace("Y=", "");
                    // Extraer Z
                    string zStr = parts[2].Replace("Z=", "");
                    double x, y, z;
                    if (!double.TryParse(xStr, out x))
                        return;
                    if (!double.TryParse(yStr, out y))
                        return;
                    if (!double.TryParse(zStr, out z))
                        return;
                    accelX = x;
                    accelY = y;
                    accelZ = z;
                    */
                    //escribe los datos de la acceleracion en el monitor  serial
                    textBoxParsed.AppendText(
                      $"X={accelX:F0} Y={accelY:F0} Z={accelZ:F0}" +
                        Environment.NewLine
                        );
                    //limpia los textbox cuando se acumulan 2000 lineas
                    if (textBoxParsed.Lines.Length > 2000)
                    {
                        textBoxParsed.Clear();
                    }
                    if (textBoxData.Lines.Length > 2000)
                    {
                        textBoxData.Clear();
                    }
                    /*
                    labelAccelX.Text = "X: " + accelX.ToString("F0");
                    labelAccelY.Text = "Y: " + accelY.ToString("F0");
                    labelAccelZ.Text = "Z: " + accelZ.ToString("F0");
                    */
                    // se escriben las aceleracione en combobox
                    labelAccelX.Text = "X: " + accelX.ToString("F2");
                    labelAccelY.Text = "Y: " + accelY.ToString("F2");
                    labelAccelZ.Text = "Z: " + accelZ.ToString("F2");
                    // Delta de tiempo
                    DateTime currentTime = DateTime.Now;
                    double dt = (currentTime - lastTime).TotalSeconds;
                    lastTime = currentTime;
                    // calculo de las velocidades
                    velX += accelX * dt;
                    velY += accelY * dt;
                    velZ += accelZ * dt;
                    // se escriben las velocidades en combobox
                    labelVelX.Text = "X: " + velX.ToString("F2");
                    labelVelY.Text = "Y: " + velY.ToString("F2");
                    labelVelZ.Text = "Z: " + velZ.ToString("F2");
                    // calculo de los angulos
                    pitch =
                    Math.Atan2(
                        accelY,
                        Math.Sqrt(accelX * accelX + accelZ * accelZ)
                    ) * 180.0 / Math.PI;
                    roll =
                        Math.Atan2(
                            -accelX,
                            Math.Sqrt(accelY * accelY + accelZ * accelZ)
                        ) * 180.0 / Math.PI;
                    // se escriben los angulos en combobox
                    labelPitch.Text = "Pitch: " + pitch.ToString("F2");
                    labelRoll.Text = "Roll: " + roll.ToString("F2");
                    //proteccion por si seleccionan varios modos de control a la vez
                    int modos = 0;
                    if (checkBoxControl.Checked) modos++; //este modo esta oculto
                    if (checkBoxLegacy.Checked) modos++;
                    if (checkBoxMouse.Checked) modos++;
                    if (checkBoxArrows.Checked) modos++;
                    if (modos > 1)
                    {
                        labelControl.Text = "ERROR";
                        return;
                    }
                    // modo de control wasd este esta oculto en la app porque no funciona bien
                    if (checkBoxControl.Checked)
                        checkBoxMouse.Checked = false;
                    checkBoxLegacy.Checked = false;
                    labelControl.Text = "CENTRO";
                    // W (Pitch negativo)
                    if (!wPressed && pitch < -30)
                    {
                        labelControl.Text = "W";
                        PressKey(0x57, ref wPressed);
                    }
                    else if (wPressed && pitch > -15)
                    {
                        ReleaseKey(0x57, ref wPressed);
                    }
                    // S (Pitch positivo)
                    if (!sPressed && pitch > 30)
                    {
                        labelControl.Text = "S";
                        PressKey(0x53, ref sPressed);
                    }
                    else if (sPressed && pitch < 15)
                    {
                        ReleaseKey(0x53, ref sPressed);
                    }
                    // A (Roll positivo)
                    if (!aPressed && roll > 40)
                    {
                        labelControl.Text = "A";
                        PressKey(0x41, ref aPressed);
                    }
                    else if (aPressed && roll < 20)
                    {
                        ReleaseKey(0x41, ref aPressed);
                    }
                    // D (Roll negativo)
                    if (!dPressed && roll < -40)
                    {
                        labelControl.Text = "D";
                        PressKey(0x44, ref dPressed);
                    }
                    else if (dPressed && roll > -20)
                    {
                        ReleaseKey(0x44, ref dPressed);
                    }
                    // SPACE
                    double magnitud =
                        Math.Sqrt(
                            accelX * accelX +
                            accelY * accelY +
                            accelZ * accelZ
                        );
                    if (magnitud > 500)
                    {
                        labelControl.Text = "SPACE";
                        PressKey(0x20, ref spacePressed);
                    }
                    else
                    {
                        ReleaseKey(0x20, ref spacePressed);
                    }
                    // Mostrar CENTRO cuando no hay ninguna tecla activa
                    if (!wPressed &&
                        !aPressed &&
                        !sPressed &&
                        !dPressed &&
                        !spacePressed)
                    {
                        labelControl.Text = "CENTRO";
                    }
                    //modo de control WASD legacy, este si funciona
                    if (checkBoxLegacy.Checked)
                    {
                        checkBoxControl.Checked = false;
                        checkBoxMouse.Checked = false;
                        //punto muerto del centro
                        if (Math.Abs(pitch) < 10 &&
                            Math.Abs(roll) < 10)
                        {
                            labelControl.Text = "CENTRO";
                        }
                        //W
                        else if (pitch < -30)
                        {
                            wPressed = true;
                            labelControl.Text = "W";
                            LegacyPressKey(0x57);
                        }
                        else if (wPressed && pitch > -15)
                        {

                            LegacyReleaseKey(0x57);
                            wPressed = false;
                        }
                        //S
                        else if (pitch > 30)
                        {
                            sPressed = true;
                            labelControl.Text = "S";
                            LegacyPressKey(0x53);
                        }
                        else if (sPressed && pitch < 15)
                        {

                            LegacyReleaseKey(0x53);
                            sPressed = false;
                        }
                        //A
                        else if (roll > 40)
                        {
                            aPressed = true;
                            labelControl.Text = "A";
                            LegacyPressKey(0x41);
                        }
                        else if (aPressed && roll < 20)
                        {

                            LegacyReleaseKey(0x41);
                            aPressed = false;
                        }
                        //D
                        else if (roll < -40)
                        {
                            dPressed = true;
                            labelControl.Text = "D";
                            LegacyPressKey(0x44);
                        }
                        else if (dPressed && roll > -20)
                        {

                            LegacyReleaseKey(0x44);
                            dPressed = false;
                        }
                        //SPACE
                        double magnitudb =
                            Math.Sqrt(
                                accelX * accelX +
                                accelY * accelY +
                                accelZ * accelZ
                            );
                        if (magnitudb > 500)
                        {
                            labelControl.Text = "ESPACIO";
                            LegacyPressKey(0x20);
                        }
                    }
                    //modo de control del mouse con la FPGA
                    if (checkBoxMouse.Checked)
                    {
                        checkBoxControl.Checked = false;
                        checkBoxLegacy.Checked = false;
                        labelControl.Text = "MOUSE";
                        Point pos = Cursor.Position;
                        //ounto muerto
                        if (Math.Abs(roll) < 10)
                            roll = 0;

                        if (Math.Abs(pitch) < 10)
                            pitch = 0;
                        //ajuste de sensibilidad
                        double sensibilidad = 0.5;
                        //calculo de como se mueve el mouse
                        int dx = (int)(-roll * sensibilidad);
                        int dy = (int)(pitch * sensibilidad);
                        //mover el mouse
                        SetCursorPos(
                            pos.X + dx,
                            pos.Y + dy
                        );
                    }
                    //control por flechas
                    if (checkBoxArrows.Checked)
                    {
                        checkBoxControl.Checked = false;
                        checkBoxLegacy.Checked = false;
                        checkBoxMouse.Checked = false;
                        labelControl.Text = "CENTRO";
                        // ARRIBA
                        if (!upPressed && pitch < -30)
                        {
                            labelControl.Text = "↑";
                            LegacyPressKey(0x26);
                            upPressed = true;
                        }
                        else if (upPressed && pitch > -15)
                        {
                            LegacyReleaseKey(0x26);
                            upPressed = false;
                        }
                        // ABAJO
                        if (!downPressed && pitch > 30)
                        {
                            labelControl.Text = "↓";
                            LegacyPressKey(0x28);
                            downPressed = true;
                        }
                        else if (downPressed && pitch < 15)
                        {
                            LegacyReleaseKey(0x28);
                            downPressed = false;
                        }
                        // IZQUIERDA
                        if (!leftPressed && roll > 40)
                        {
                            labelControl.Text = "←";
                            LegacyPressKey(0x25);
                            leftPressed = true;
                        }
                        else if (leftPressed && roll < 20)
                        {
                            LegacyReleaseKey(0x25);
                            leftPressed = false;
                        }
                        // DERECHA
                        if (!rightPressed && roll < -40)
                        {
                            labelControl.Text = "→";
                            LegacyPressKey(0x27);
                            rightPressed = true;
                        }
                        else if (rightPressed && roll > -20)
                        {
                            LegacyReleaseKey(0x27);
                            rightPressed = false;
                        }
                        //ESPACE
                        double magnituda =
                            Math.Sqrt(
                             accelX * accelX +
                             accelY * accelY +
                             accelZ * accelZ
                               );
                        if (!spacePressed && magnituda > 500)
                        {
                            labelControl.Text = "SPACE";
                            LegacyPressKey(0x20);
                            spacePressed = true;
                        }
                        else if (spacePressed && magnitud < 450)
                        {
                            LegacyReleaseKey(0x20);
                            spacePressed = false;
                        }
                        if (!upPressed &&
                            !downPressed &&
                            !leftPressed &&
                            !rightPressed &&
                            !spacePressed)
                        {
                            labelControl.Text = "CENTRO";
                        }
                    }
                }));
            }
            catch
            {
            }
         }
